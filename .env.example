NODE_ENV=development
DEBUG=false
ENABLE_CHEATS=false
MONGO_URL=
# Signs "Remember me" login tokens. Unset, they stop working when the server restarts.
AUTH_SECRET=
SERVER_FPS=20
SERVER_URL=http://localhost:3000
PORT=3000
ASSETS_URL=
PUBLIC_DIR=public
PEER_SERVER_PORT=9000
PEER_CLIENT_PORT=9000
# Wandering bots the server brings in on start (0 = none).
BOTS=0

# Metered TURN/STUN for WebRTC (https://www.metered.ca/) — credential API key is safe for client; bake via Vite.
METERED_APP_NAME=
METERED_API_KEY=
METERED_REGION=global
