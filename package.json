{
  "name": "aether",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "oxlint",
    "client:dev": "vite --config client/vite.config.ts",
    "client:build": "vite build --config client/vite.config.ts",
    "client:preview": "vite preview --config client/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "server:dev": "tsx --env-file-if-exists=.env server/main.ts",
    "server:watch": "tsx watch --inspect --env-file-if-exists=.env server/main.ts",
    "clean": "rm -rf node_modules",
    "server:build": "node --env-file-if-exists=.env build.server.js",
    "server:run": "node --env-file-if-exists=.env --optimize-for-size --max-old-space-size=512 dist/server.js",
    "test": "vitest run",
    "format": "oxfmt",
    "dev": "concurrently -k -n server,client,web -c blue,green,magenta \"npm:server:watch\" \"npm:client:dev\" \"npm:web:dev\"",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "check:format": "oxfmt --check",
    "check": "npm run check:format && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "canvas": "^3.2.3",
    "cors": "^2.8.6",
    "easystarjs": "^0.4.4",
    "express": "^5.3.0",
    "framer-motion": "^14.6.0",
    "http-proxy-middleware": "^4.2.1",
    "jsdom": "^30.1.3",
    "lodash": "^4.18.1",
    "mongodb": "^7.7.0",
    "nanoid": "^6.0.2",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tooltip": "^6.0.9",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "theme-ui": "^0.17.4",
    "use-double-tap": "^1.3.7",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "ts-patch": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
