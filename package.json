{
  "name": "aether",
  "type": "module",
  "private": true,
  "version": "0.12.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "oxlint",
    "client:dev": "vite --config src/client/vite.config.ts",
    "client:build": "vite build --config src/client/vite.config.ts",
    "client:preview": "vite preview --config src/client/vite.config.ts",
    "web:dev": "vite --config src/wiki/vite.config.ts",
    "web:build": "vite build --config src/wiki/vite.config.ts",
    "web:preview": "vite preview --config src/wiki/vite.config.ts",
    "server:dev": "tsx --env-file-if-exists=.env src/server/main.ts",
    "server:watch": "tsx watch --include .env --inspect --env-file-if-exists=.env src/server/main.ts",
    "clean": "rm -rf node_modules",
    "server:build": "tsx --env-file-if-exists=.env scripts/build-server.ts",
    "server:run": "node --env-file-if-exists=.env --optimize-for-size --max-old-space-size=512 dist/server.cjs",
    "test": "vitest run",
    "format": "oxfmt",
    "dev": "concurrently -k --pad-prefix -n server,client,wiki -c blue,green,magenta \"npm run -s server:watch\" \"npm run -s client:dev\" \"npm run -s web:dev\"",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "check:format": "oxfmt --check",
    "check:structure": "tsx scripts/check-structure.ts",
    "check:weapon-tips": "tsx scripts/weapon-tips.ts --check",
    "weapon-tips": "tsx scripts/weapon-tips.ts",
    "check": "npm run check:format && npm run lint && npm run typecheck && npm run check:structure && npm run check:weapon-tips && npm run check:dead-code && npm run test",
    "check:dead-code": "knip --no-progress"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.6",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "cors": "^2.8.6",
    "easystarjs": "^0.4.4",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "mongodb": "^7.7.0",
    "nanoid": "^6.0.2",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tooltip": "^6.0.9",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "theme-ui": "^0.17.4",
    "use-double-tap": "^1.3.7",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
